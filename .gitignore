# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg

# Virtual environments
.env
.venv
venv/
ENV/

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Linter & Formatter caches
.ruff_cache/
.mypy_cache/

# Datasets, caches & raw data (DO NOT COMMIT)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
data/cache/**
!data/cache/**/
!data/cache/**/.gitkeep

# Outputs, logs, models & checkpoints (DO NOT COMMIT)
outputs/**
!outputs/**/
!outputs/**/.gitkeep
*.log
*.joblib
*.pkl
*.pt
*.onnx
checkpoint/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# OS-generated files
Thumbs.db
desktop.ini
.DS_Store
